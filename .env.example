# .env de la app hija "sincro-odoo-depofis". Copiar a .env EN EL BOX y completar.
# El .env real nunca se commitea.

NODE_ENV=production
PORT=3038

# En dev, el origin de vite (ver vite.config.ts). En producción la app se sirve
# desde el mismo origin que el IdP, así que esto queda como está.
CORS_ORIGIN=http://localhost:5188

# ─── SSO (política madre-hijas) ──────────────────────────────────────────
# DASSA_APPS_SSO_SECRET lo imprime `node scripts/setup-idp.cjs --apply`
# cuando registra la app. LOCAL_SESSION_SECRET se genera acá:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DASSA_APPS_SSO_URL=http://127.0.0.1:3040
DASSA_APPS_SSO_PUBLIC_URL=https://apps.dassa.com.ar
DASSA_APPS_SSO_SECRET=
LOCAL_SESSION_SECRET=
SSO_COOKIE_NAME=sincro_odoo_depofis_sso_session
SSO_SESSION_TTL_MIN=60

# ─── Base ────────────────────────────────────────────────────────────────
# Smart DASSA Central, schema `sincro_odoo_depofis`.
# ⚠️ SIEMPRE por el pooler `aws-1-sa-east-1`: el direct connection es IPv6-only
# y el VPS no rutea IPv6. Y es `aws-1-`, no `aws-0-` ("Tenant or user not found").
SINCRO_ODOO_DEPOFIS_PG_DSN=postgresql://sincro_odoo_depofis_app.txlotccsiqaypkzobkxm:CAMBIAR@aws-1-sa-east-1.pooler.supabase.com:5432/postgres
LOG_QUERIES=false

# ─── Token de máquina para sincronizar.py ────────────────────────────────
# >= 32 chars. Mismo valor en el .env de la rutina (SINCRO_ODOO_DEPOFIS_SERVICE_TOKEN).
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SINCRO_ODOO_DEPOFIS_SERVICE_TOKEN=

# ═════════════════════════════════════════════════════════════════════════
# Lo que sigue lo lee sincronizar.py (la rutina Python), no el server Node.
# ═════════════════════════════════════════════════════════════════════════

# Odoo — API key personal, solo lectura (ver CLAUDE.md § El Odoo de DASSA).
# ODOO_LOGIN/ODOO_KEY tambien se aceptan con los nombres que usa
# conciliacion-proveedores: ODOO_USER / ODOO_API_KEY.
ODOO_URL=https://gestion.dassa.com.ar
ODOO_LOGIN=facundo@pymetech.com.ar
ODOO_KEY=
ODOO_DB=soylinux-dassa-main-32105727

# DEPOFIS · ESPEJO — para LEER. Es la fuente por default de las simulaciones,
# y lo que manda la regla de datos de DASSA: las apps nuevas leen el espejo.
# ⚠️ El schema es `depofis_mirror`, NO `depofis`: ese otro está congelado desde
# 2026-05-10, tiene 12 columnas y ni siquiera trae tipo_cl.
SINCRO_ESPEJO_PG_DSN=postgresql://smartdassa_satellite_reader.txlotccsiqaypkzobkxm:CAMBIAR@aws-1-sa-east-1.pooler.supabase.com:5432/postgres

# DEPOFIS · ORIGEN (SQL Server) — sólo hace falta para ESCRIBIR.
# ⚠️ "host,puerto", SIN el nombre de instancia: desde Linux la forma con
# instancia necesita al SQL Browser en UDP 1434 y no responde. Y va sin cifrado
# (Encrypt=no), igual que el ETL de depofis-mirror.
DEPOFIS_SERVER=101.44.8.58,1436
DEPOFIS_USER=
DEPOFIS_PASSWORD=

# Marcador de auditoría de las filas que cree la rutina (char(10)).
# Misma convención que `dassa-orden`, que usa 'ORDEN_APP'. Es lo que permite
# distinguir lo automático de lo que cargó una persona, y acota el DELETE.
DEPOFIS_US_ADD=ODOO

# A dónde publica la corrida.
SINCRO_API_URL=http://127.0.0.1:3038

# 🔒 EL FRENO. Sin esta variable en "si", `--aplicar` se rechaza y la rutina
# corre en simulación. Está aparte del flag a propósito: hacen falta las DOS
# cosas para que algo se escriba en DEPOFIS.
SINCRO_PERMITIR_APLICAR=no
